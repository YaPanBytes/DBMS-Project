# ConsentLedger Environment Configuration
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql+psycopg://consentledger:consentledger@localhost:5432/consentledger

# SQLAlchemy
SQL_ECHO=false

# Security
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# AI/ML (Member B)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Monitoring (Optional)
# PROMETHEUS_ENDPOINT=
# GRAFANA_ENDPOINT=