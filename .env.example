# ConsentLedger configuration. Copy to .env and fill in real values.
# Secrets live only in .env (which is git-ignored), never in code.

ENVIRONMENT=development

# ---- Database (password is a secret)
DATABASE_URL=postgresql+psycopg://consentledger:consentledger@localhost:5432/consentledger
# Non-owner role each API request runs as, so row-level security applies
DB_APP_ROLE=consentledger_app
# Optional: run the tests against a specific throwaway database
# TEST_DATABASE_URL=postgresql+psycopg://consentledger:consentledger@localhost:5432/consentledger_test
SQL_ECHO=false

# ---- Field encryption (pgcrypto key for encrypted dataset columns) - secret
ENCRYPTION_KEY=change-me-to-a-long-random-string

# ---- JWT sessions - secret; generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Set true when served over HTTPS (required in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- Google OAuth 2.0 (Google Cloud console > APIs & Services > Credentials)
# Authorised redirect URI: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Email + password login for demo accounts (bcrypt hashes)
ALLOW_PASSWORD_LOGIN=true
# Failed password logins allowed per email and client address, and the window
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900

# ---- Frontend / CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
