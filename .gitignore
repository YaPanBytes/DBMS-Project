# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment files
.env
.env.local
.env.*.local

# Database
*.db
*.sqlite
*.sqlite3
backups/
*.dump
*.sql
*.sql.gz
# ...but never ignore the schema migrations
!database/migrations/*.sql
!database/migrations/down/*.sql
!database/queries/*.sql

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test coverage
htmlcov/
.coverage
.coverage.*
coverage.xml
.pytest_cache/

# Type checking
.mypy_cache/
.ruff_cache/

# Distribution
dist/
build/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Docker
.docker/

# Frontend
frontend/node_modules/
frontend/dist/

# AI artefacts (regenerated by the seed / detector)
ai/data/*.csv
ai/models/*.joblib

# Temporary files
tmp/
temp/
*.tmp